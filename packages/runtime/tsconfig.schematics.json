{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "lib": ["ES2022"],
    "outDir": "./schematics",
    "rootDir": "./schematics",
    "declaration": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["schematics/**/*.spec.ts", "node_modules"]
}
